<!-- =================================================================================== -->
<robot name="nino">
  <material name="chassis_blue">
    <color rgba="0.18 0.42 0.80 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="metal_grey">
    <color rgba="0.48 0.50 0.52 1.0"/>
  </material>
  <!--
    The model is spawned at world (0, 0, 0).  base_footprint lies on the
    ground; this fixed offset places the drive-wheel centres one radius above
    it, avoiding the common "spawn below the floor" workaround.
  -->
  <link name="base_footprint"/>
  <link name="base_link">
    <inertial>
      <!-- CAD center of mass and moments scaled to a 2.5 kg chassis;
           lateral COM and cross-products stay symmetric. -->
      <origin rpy="0 0 0" xyz="0.0592774512 0 0.0848297985"/>
      <mass value="2.5"/>
      <inertia ixx="0.0195929757" ixy="0" ixz="-0.0002725076" iyy="0.0323802641" iyz="0" izz="0.0489682473"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://nino_description/meshes/base_link.STL"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <!-- Use the CAD chassis in the identical frame for exact visual/collision
         alignment. Do not add an origin offset or an independent scale here. -->
    <collision>
      <geometry>
        <mesh filename="package://nino_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0625"/>
  </joint>
  <!--
    Sensor names and topics intentionally match Linorobot2 Jazzy:
      imu_link -> /imu/data
      laser    -> /scan
    Their fixed joints are published by robot_state_publisher.
  -->
  <link name="imu_link"/>
  <joint name="imu_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.05 0 0.10"/>
  </joint>
  <link name="laser">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.3"/>
      <!-- Solid-cylinder inertia for radius 0.0375 m and height 0.05 m. -->
      <inertia ixx="0.000727864583" ixy="0" ixz="0" iyy="0.000727864583" iyz="0" izz="0.0009140625"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.0375"/>
      </geometry>
      <material name="sensor_green">
        <color rgba="0.003 0.639 0.223 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.0375"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- Center of the four-hole top-plate pattern (x=0.1725/0.2275,
         y=+/-0.015); the cylinder bottom sits on the z=0.14 plate. -->
    <origin rpy="0 0 0" xyz="0.20 0 0.165"/>
  </joint>
  <!-- A shallow downward-looking scan gives the policy deployable preview of
       low cables and terrain before the casters reach them. It is mounted
       just beyond the 0.31 m CAD chassis nose so the robot cannot occlude its
       rays. Its housing sits above the horizontal /scan plane, so the main
       LiDAR does not mistake this sensor for an obstacle. At 0.2625 m height
       and 0.45 rad pitch it observes the floor about 0.54 m ahead; the
       horizontal fan distinguishes left/right terrain. -->
  <link name="terrain_laser">
    <visual>
      <geometry>
        <box size="0.035 0.055 0.025"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
  </link>
  <joint name="terrain_laser_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="terrain_laser"/>
    <origin rpy="0 0.45 0" xyz="0.33 0 0.20"/>
  </joint>
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Ground-truth velocity is used only to measure simulated wheel slip;
         it is never used for localization or direct control. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/nino/odometry</odom_topic>
    </plugin>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu/data</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="laser">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <!-- Goal beacon is visible in the GUI, never a laser obstacle. -->
        <visibility_mask>4294967291</visibility_mask>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <link name="left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0221316704"/>
      <!-- Keep the CAD inertia ratios when increasing each wheel to 0.8 kg. -->
      <mass value="0.8"/>
      <inertia ixx="0.00082103250" ixy="0" ixz="0" iyy="0.00082103250" iyz="0" izz="0.00145127478"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://nino_description/meshes/left_wheel_link.STL"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0235"/>
      <geometry>
        <cylinder length="0.047" radius="0.0625"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="1.5707963267948966 0 0" xyz="0 0.1935 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <!-- -Z in the rotated joint frame is +Y in the robot frame. -->
    <axis xyz="0 0 -1"/>
    <!-- 24 rad/s is the emergency joint limit.  The effort controller uses
           a 12 rad/s software limit, leaving transient feedback margin. -->
    <limit effort="12.0" velocity="24.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>
  <link name="right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0221316704"/>
      <!-- Keep the CAD inertia ratios when increasing each wheel to 0.8 kg. -->
      <mass value="0.8"/>
      <inertia ixx="0.00082103250" ixy="0" ixz="0" iyy="0.00082103250" iyz="0" izz="0.00145127478"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://nino_description/meshes/right_wheel_link.STL"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.0235"/>
      <geometry>
        <cylinder length="0.047" radius="0.0625"/>
