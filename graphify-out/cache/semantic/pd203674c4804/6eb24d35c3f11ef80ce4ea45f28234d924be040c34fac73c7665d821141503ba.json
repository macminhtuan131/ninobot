{"nodes": [{"id": "src_nino_pi_wheel_response_protocol_document", "label": "Wheel Response Protocol", "file_type": "document", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L1-L216", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_nino_pi_wheel_response_protocol_motion_release_contract", "label": "Motion Release Contract", "file_type": "rationale", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L7-L14; L65-L89; L120-L144; L198-L216", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new protocol must explicitly confirm owners, RC selection/arm/stop, backend, bounds, clocks, abort rules, and operator readiness. Generic templates and --check do not enforce or grant release. Historical V1/V2 slots remain closed; the draft six-trial design is not granted budget. Software preparation creates no physical evidence."}, {"id": "src_nino_pi_wheel_response_protocol_fresh_enable_acknowledgement", "label": "Fresh Enable Acknowledgement", "file_type": "rationale", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L84-L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pre-existing enable bit is not a fresh ACK. Proposed helper startup disables gate, sends zero, requests firmware disable, observes a later disabled status, holds zero, then requests enable and requires a new enabled status. Firmware g_system_enabled precedes RC arbitration and can differ from effective_enable; ACK does not prove physical motor permission."}, {"id": "src_nino_pi_wheel_response_protocol_aggregate_wheel_response", "label": "Aggregate Wheel Response", "file_type": "concept", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L16-L39; L132-L139; L154-L166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The minimum claim uses final /cmd_vel, /motor_fb, and /motor_status to measure aggregate request-to-reported-wheel behavior, including transport, firmware, ramp/mode, and wheel mechanics. It cannot isolate motor PI latency without target telemetry. Straight equal-wheel references do not distinguish swapped left/right channels. Broader chain claims require every actual stage to be required."}, {"id": "src_nino_pi_wheel_response_protocol_preregistered_response_metrics", "label": "Preregistered Response Metrics", "file_type": "rationale", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L142-L144; L168-L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Define baseline noise, sustained onset, settling, T90 endpoint, sampling resolution, gap/coverage, and invalid/abort rules before trials. T90 from ramp start includes ramp duration and is not transport latency or a motor time constant. Nominal geometry-derived wheel endpoints are not executed-target telemetry. Wheel settling is not independently measured body stopping."}, {"id": "src_nino_pi_wheel_response_protocol_failure_censoring", "label": "Failure Censoring", "file_type": "rationale", "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L146-L152; L179-L196; L205-L210", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retain aborts, timeout, missing samples, spikes, endpoint nonattainment, and right-censored response windows. Do not replace unknown metrics with zero, redefine endpoints after fitting, or silently retry/increase sample count. source_sequence_completed only reports helper sequence completion; encoder/body disagreement remains physically unknown rather than an assumed slip event."}], "edges": [{"source": "src_nino_pi_wheel_response_protocol_document", "target": "src_nino_pi_wheel_response_protocol_motion_release_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L65-L89; L120-L144; L198-L216", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_document", "target": "src_nino_pi_wheel_response_protocol_fresh_enable_acknowledgement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L84-L108", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_document", "target": "src_nino_pi_wheel_response_protocol_aggregate_wheel_response", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L16-L39; L154-L166", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_document", "target": "src_nino_pi_wheel_response_protocol_preregistered_response_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L142-L144; L168-L191", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_document", "target": "src_nino_pi_wheel_response_protocol_failure_censoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L146-L152; L179-L196", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_fresh_enable_acknowledgement", "target": "src_nino_pi_stm32_usb_integration_motor_status_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L90-L99", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_motion_release_contract", "target": "src_nino_pi_laptop_control_and_collection_command_ownership", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L72-L79", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_aggregate_wheel_response", "target": "src_nino_pi_real_data_collection_receipt_clock_semantics", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L154-L166", "weight": 1.0}, {"source": "src_nino_pi_wheel_response_protocol_preregistered_response_metrics", "target": "src_nino_pi_wheel_response_protocol_failure_censoring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md", "source_location": "L179-L191", "weight": 1.0}], "hyperedges": [{"id": "src_nino_pi_wheel_response_protocol_velocity_authority_contract", "label": "Velocity Authority Contract", "nodes": ["src_nino_pi_wheel_response_protocol_motion_release_contract", "src_nino_pi_wheel_response_protocol_fresh_enable_acknowledgement", "src_nino_pi_stm32_usb_integration_actuator_mode_arbitration", "src_nino_pi_laptop_control_and_collection_command_ownership"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/nino_pi/WHEEL_RESPONSE_PROTOCOL.md"}]}