{"nodes": [{"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_document", "label": "Real Data Requirements Without Camera", "file_type": "document", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L1-L153", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_camera_optional_acquisition", "label": "Camera Optional Acquisition", "file_type": "rationale", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L20-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The operator has no camera. Camera absence does not block acquisition contracts, observation history, reported-wheel identification, or zero-authority shadow. History still requires correct adapter ABI, frames, freshness, and causality. Physical body/slip claims require a suitable independent reference, which may use another measurement method."}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_independent_body_reference", "label": "Independent Body Reference", "file_type": "rationale", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L23-L24; L34-L44; L66-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent body measurements distinguish wheel rotation from body displacement, speed, slip, stopping, and navigation error. Encoder-derived odometry is not independent body truth. A measurement must match the claimed quantity and declare geometry, timing, fusion, uncertainty, and validation limits."}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_endpoint_measurement", "label": "Endpoint Measurement", "file_type": "concept", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L84-L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A proposed fixed body marker and floor datum measured before/after by tape can establish endpoint displacement with resolution and repeatability uncertainty. Wheel visibility is recorded separately. Endpoints provide no body time series, onset, T90, instantaneous speed, post-zero stopping distance, or slip ratio. The diagnostic has not been executed."}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_lidar_reference_candidate", "label": "LiDAR Reference Candidate", "file_type": "concept", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L70-L70; L109-L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LiDAR-only scan matching in a structured scene is proposed as a body trajectory/heading estimator, with endpoint checks and declared fusion. Historical approximately 7 Hz scans do not establish suitability for approximately 100 ms transients, contact, pitch, or feature-poor scenes. Endpoint validation does not validate every trajectory point."}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_reported_wheel_sysid", "label": "Reported Wheel SysID", "file_type": "concept", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L39-L39; L68-L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identification fits aggregate final-request-to-reported-wheel delay, lag, and gain with nominal geometry and a common receipt clock. residual_sysid.py requires at least three complete sessions, nonempty whole-session holdout, SI units, clocks, and provenance. These software gates do not establish statistical sufficiency, calibrated body dynamics, or physical channel mapping."}, {"id": "docs_nino_real_data_requirements_no_camera_2026_11_09_claim_specific_quality", "label": "Claim Specific Quality", "file_type": "rationale", "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L113-L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw integrity, reported-wheel usability, endpoint usability, validated trajectory, and measurable slip are distinct quality claims. Studio remains capped at WARN/Q2 rather than automatically promoting tape measurements to Q3/Q4. A dedicated manual endpoint entry workflow was not yet implemented; annotations belong in separate derived records."}], "edges": [{"source": "docs_nino_real_data_requirements_no_camera_2026_11_09_document", "target": "docs_nino_real_data_requirements_no_camera_2026_11_09_camera_optional_acquisition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L20-L44", "weight": 1.0}, {"source": "docs_nino_real_data_requirements_no_camera_2026_11_09_document", "target": "docs_nino_real_data_requirements_no_camera_2026_11_09_independent_body_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L23-L44", "weight": 1.0}, {"source": "docs_nino_real_data_requirements_no_camera_2026_11_09_document", "target": "docs_nino_real_data_requirements_no_camera_2026_11_09_endpoint_measurement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_location": "L84-L107", "weight": 1.0}, {"source": "docs_nino_real_data_requirements_no_camera_2026_11_09_document", "target": "docs_nino_real_data_requirements_no_camera_2026_11_09_lidar_reference_candidate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_REAL_DATA_REQUIREMENTS_NO_CAMERA_2026-11-09.md", "source_