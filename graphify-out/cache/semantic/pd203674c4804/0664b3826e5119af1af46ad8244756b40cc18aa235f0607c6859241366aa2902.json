{"nodes": [{"id": "src_nino_pi_laptop_control_and_collection_document", "label": "Laptop Control and Collection", "file_type": "document", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L1-L281", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_nino_pi_laptop_control_and_collection_ssh_operator_workflow", "label": "SSH Operator Workflow", "file_type": "concept", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L21-L30; L118-L176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "laptop_control.py and its shell wrapper run Pi keyboard/control commands through SSH; laptop ROS networking is optional for RViz. The collector runs separately in the verified driver domain. Recording precedes enable, driving ends before recording, and recording continues through settling. Stopping the collector does not stop the robot."}, {"id": "src_nino_pi_laptop_control_and_collection_command_pipeline", "label": "Command Pipeline", "file_type": "concept", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L7-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual or Nav2 source enters the initially disabled command_gate, then /cmd_vel_selected, velocity_smoother, /cmd_vel_smoothed, Collision Monitor using scan/TF, and final /cmd_vel to the real backend. The package does not supply real motor/sensor drivers. Initial YAML limits are not hardware calibration."}, {"id": "src_nino_pi_laptop_control_and_collection_command_ownership", "label": "Command Ownership", "file_type": "rationale", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L74-L100; L126-L131; L164-L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the real driver's verified domain and audit all command-stage publishers. Launch-time duplicate-stack checks are snapshots rather than distributed locks. Do not run keyboard and joystick on the same teleop topic or competing publishers directly to final /cmd_vel. Publication ownership must remain valid during the actual trial."}, {"id": "src_nino_pi_laptop_control_and_collection_gate_stop_latch", "label": "Gate Stop Latch", "file_type": "concept", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L154-L190; L271-L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Software stop latches the gate; reset requires disable followed by reset_stop and does not automatically enable. Keyboard expiry and gate timeout depend on the functioning software chain and do not replace motor watchdog or physical stop. Mode switching clears gate commands but does not cancel a Nav2 action."}, {"id": "src_nino_pi_laptop_control_and_collection_localization_authority", "label": "Localization Authority", "file_type": "rationale", "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L193-L262", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mapping and navigation must avoid duplicate command stacks and map-to-odom owners. Navigation uses a real measured occupancy map stored on Pi after mapping/SLAM stops; helper launch neither enables nor sends a goal. Goal/route metadata is needed because /goal_pose is not a complete action-goal log."}], "edges": [{"source": "src_nino_pi_laptop_control_and_collection_document", "target": "src_nino_pi_laptop_control_and_collection_ssh_operator_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L21-L30; L118-L176", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_document", "target": "src_nino_pi_laptop_control_and_collection_command_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L7-L36", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_document", "target": "src_nino_pi_laptop_control_and_collection_command_ownership", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L74-L100; L126-L131", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_document", "target": "src_nino_pi_laptop_control_and_collection_gate_stop_latch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L154-L190; L271-L273", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_document", "target": "src_nino_pi_laptop_control_and_collection_localization_authority", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L193-L262", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_ssh_operator_workflow", "target": "src_nino_pi_nino_pi_laptop_control", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L21-L25", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_ssh_operator_workflow", "target": "src_nino_pi_scripts_laptop_control", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L21-L21; L102-L112", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_command_pipeline", "target": "src_nino_pi_config_control", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L32-L36; L80-L81", "weight": 1.0}, {"source": "src_nino_pi_laptop_control_and_collection_gate_stop_latch", "target": "src_nino_pi_nino_pi_command_gate", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/nino_pi/LAPTOP_CONTROL_AND_COLLECTION.md", "source_location": "L178-L190", "weight": 1.0}], "hyperedges": []}