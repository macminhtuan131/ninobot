{"nodes": [{"id": "src_nino_pi_real_data_collection_document", "label": "Real Data Collection", "file_type": "document", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L1-L334", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_nino_pi_real_data_collection_read_only_acquisition", "label": "Read Only Acquisition", "file_type": "rationale", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L38-L66; L224-L251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The collector records existing drivers without launching control or sending motor commands. rosbag2 and audit run in separate processes so audit conversion is outside the recording callback. --check validates an offline plan without ROS or output creation. Capture budgets and clean closure do not grant motion authority."}, {"id": "src_nino_pi_real_data_collection_hardware_inventory_audit", "label": "Hardware Inventory Audit", "file_type": "concept", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L52-L55; L74-L89; L164-L179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hardware_audit inventories graph endpoints, packages, allowed read-only parameters, TF, timestamps, observed rates, and power evidence. It uses the actual driver domain/overlay. A node or package name does not prove physical connectivity, installed TF does not verify mounting, and absent warnings do not establish adequate power."}, {"id": "src_nino_pi_real_data_collection_raw_session_bundle", "label": "Raw Session Bundle", "file_type": "concept", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L255-L291", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The session bundle retains manifest, session metadata, actual collection/QoS configuration, optional signal mapping, raw CDR bag and metadata, recorder/audit logs, audit graph/samples, power timeline, and hashes. Failures and spikes remain with the raw data. Offline inspection/export does not require replaying command topics into a robot network."}, {"id": "src_nino_pi_real_data_collection_capture_completeness", "label": "Capture Completeness", "file_type": "rationale", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L192-L205; L293-L311; L327-L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "captured_not_calibrated means required samples, readable closed storage, and completed acquisition processes, rather than calibrated sensors, timing accuracy, physical success, or safety. Missing required data stays incomplete. Counts do not establish packet loss or coverage without an independent production count. Raw failures, timestamps, outliers, and unknown values are preserved."}, {"id": "src_nino_pi_real_data_collection_receipt_clock_semantics", "label": "Receipt Clock Semantics", "file_type": "rationale", "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L83-L83; L100-L106; L300-L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bag stores recorder receipt timestamps and original message headers inside CDR. Audit adds its own monotonic/ROS receipt clocks; it does not add monotonic time to every bag sample. Twist has no source header. Multi-host age subtraction requires clock origins, offsets, synchronization, and uncertainty before being called latency."}], "edges": [{"source": "src_nino_pi_real_data_collection_document", "target": "src_nino_pi_real_data_collection_read_only_acquisition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/nino_pi/REAL_DATA_COLLECTION.md", "source_location": "L38-L66; L224-L251", "weight": 1.0}, {"source": "src_nino_pi_real_data_collection_document", "target": "src_