{"nodes": [{"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_overview", "label": "9 November project architecture and control-flow review", "file_type": "document", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L1-L801", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A source-based review dated 9 November, not a new experiment. Its planned-task and 40,860-step status must be read with the later dated README updates."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_nino_robot", "label": "Nino differential-drive robot and package responsibilities", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L11-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two driven wheels and two passive casters; Pi 5, STM32H7, USB micro-ROS and CAN motors. nino_description supplies models/worlds, nino_control control/history/projection, nino_rl tasks/learners/audits and nino_pi collection/QC/Studio. Reference firmware and package presence do not prove an active binary or launch."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_sensor_boundary", "label": "Sensor-only controller versus privileged scoring boundary", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L13-L25;L89-L113;L234-L240;L505-L511", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Causal IMU, encoder, reference and command history feed control. Ground truth and contact labels support Sim reward, scoring and audit. Existing planned-stop features require a separate shortcut audit before claims about an unknown-obstacle task."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_command_ownership", "label": "Command ownership, firmware modes and recorder independence", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L115-L127;L399-L406;L678-L691", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real velocity requests pass MCU arbitration/watchdog and CAN motor references. Torque/MIT/velocity topics can change mode when interleaved. The Pi helper chain is keyboard/Nav2, gate, smoother, Collision Monitor and final command. Recording does not enable motion, and ending recording does not stop another process's controller; installed FootprintApproach and older StopZone configurations have distinct provenance."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_observation_assembler", "label": "ObservationAssembler causal sample validation", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L163-L178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches IMU, wheels, commands and explicit health; preserves source and receipt times; rejects duplicate/reversed samples; checks required inputs and ages; applies a configured yaw rotation and retains sample provenance. This is not a fully calibrated 3D IMU transform."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_feature_history", "label": "FeatureHistory: five actual 20-feature frames at 10 Hz", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L195-L224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five oldest-to-newest frames form a flattened 100D MLP input spanning 0.4 seconds; there is no LSTM. Padding does not earn history validity. Gaps, reversal and duplicates require refilling a valid epoch. Features include reference, wheels, gyro, gravity-retaining acceleration, command/residual history, ages and consistency proxies."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_common103_v2", "label": "common103_v2 planned-stop 103D/1D contract", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L226-L240;L279-L294", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appends remaining scheduled-stop time, common-window state and previous effective scalar to 100D history. This historical trained task uses scheduled stops and a local progress marker; its success flag does not establish unknown-obstacle goal arrival."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_planar_guidance", "label": "Causal wheel/gyro pose estimator and classical follower", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L242-L261", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrates wheel-derived forward speed and gyro-Z yaw rate from causal samples, with explicit initial scenario pose rather than GT readback. The current Sim adapter follows one straight segment and supplies yaw control. Nav2 and the Pi EKF are separate implementations."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_common_velocity_action", "label": "Current TD3 action: bounded common wheel-linear correction", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L279-L294", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One scalar a in [-1,1] requests equal corrections b*a on both wheels: b=0.02 m/s for obstacle/DR and 0.005 m/s for clear floor. Differential correction is zero. Valid history, permission, sensors, steady forward motion and the planned withdrawal window govern effective authority."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_generic_velocity_residual", "label": "Generic two-action common/differential velocity residual", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L265-L277", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The separate generic ABI maps normalized common/differential proposals through an L1 normalizer to bounded left/right wheel-linear corrections. It is distinct from the current one-action common103_v2 trainer."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_reference_projection", "label": "ResidualReference request-to-accepted reference projection", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L296-L315", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces speed, yaw, wheel, acceleration, freshness, permission and stop/fault bounds. A zero baseline cannot initiate motion through residual alone. Accepted contribution is measured against a baseline projected from the same previous reference so ramp shaping is not credited to policy. Projection does not prove physical execution or safety."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_sim_velocity_pi", "label": "Simulation wheel velocity PI and torque limits", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L341-L374", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "effort_drive maps body references to wheel targets and bounded torque using Kp 0.30, Ki 0.10 and conditional anti-windup. Representative settings include 4 Nm PI contribution, 10 Nm/s slew, 12 rad/s\u00b2 target acceleration, 500 Hz callback target, 10 Hz policy and 1 ms physics. The active velocity backend sets accept_torque=false."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_real_velocity_backend", "label": "Selected real velocity backend: STM32 to motor internal loop", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L115-L127;L376-L386", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reference /cmd_vel path selects velocity mode, converts body velocity to wheel speeds and sends CAN references to the motor's internal velocity loop. Firmware source acceleration/current declarations are not readback of the flashed binary or physical motor configuration."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_real_sac_torque_backend", "label": "Separate real nino_real_rl PI/SAC torque backend", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L388-L406", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reviewed Pi controller adds two SAC wheel-torque residuals to external wheel PI, then publishes /cmd_torque through the STM32 MIT path. It uses 23D observations, two actions, 0.30 Nm residual bound and 2 Nm software total bound. This does not validate the TD3 velocity contract."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_reactive_governor", "label": "ReactiveGovernor classical state machine", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L408-L430", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses disturbance, angular-rate and wheel-error proxies with CRUISE, optional DELAY, HOLD, RECOVER, optional STALL and latched FAILSAFE. The common103_v2 trainer uses governor=False by default. Historical scale 0.90 and disabled generic 0.70 YAML are distinct settings; predictive risk/action ranking remains unvalidated."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_td3_learner", "label": "TD3 deterministic MLP learner and effective job settings", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L432-L476", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inspected CPU learner uses twin critics, delayed actor/target updates, smoothing, 256x256 networks, learning rate 0.0003, gamma 0.99, tau 0.005, batch 256, replay 100,000, fresh warmup 10,000 and policy delay 2. Effective profile and model builder determine the job. Deployment uses the deterministic actor, without real exploration or critic optimization."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_common_score_v2", "label": "CommonScoreV2 nominal tracking reward", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L478-L511", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses GT velocity/yaw error against an independently shaped zero-residual nominal reference, requested-action regularization while the window is open and terminal penalties. It has no direct per-step path, slip or IMU-impact penalty. The 9 November unknown-step reward discussion is prospective and is superseded by later task implementation reports."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_requested_action_replay", "label": "Requested-action replay semantics", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L513-L533", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projection belongs to the environment transition. Replay stores observation, requested action, reward, next observation and done; it does not silently replace the requested action with the accepted action. Windowed, projected and executed quantities are traced separately. Evaluation disables action noise and optimizer updates."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_checkpoint_abi", "label": "Checkpoint ABI, portable actor and continuation boundaries", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L535-L546", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100D/2D, 103D/1D v1, 103D/1D v2 and 23D/2D SAC are distinct contracts. Resumable bundles preserve learner/replay/identity state but not exact Gazebo/contact/RNG episode state. The current portable actor enforces two outputs and generic shadow expects its base ABI; common103_v2 needs a matching export/adapter."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_box_c1_6mm_dr", "label": "box_c1_6mm_dr historical training scenario", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L548-L571", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One rigid cylindrical C1 obstacle on a solid box floor; friction 0.85\u20131.15, obstacle X 0.55\u20130.75 m and radius 2.5\u20133.5 mm. Straight path endpoint is 3 m with 0.20 m/s cruise, alternating 6/8 s source stops and a 0.95 m local marker. Marker success is not endpoint or 6.45 m factory-goal arrival."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_v2_job_40860", "label": "9 November interrupted common103_v2 checkpoint at 40,860 steps", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L575-L597;L793-L796", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inspected failed continuation saved 30k, 40k and 40,860 checkpoints, with 30,858 optimizer cycles and replay size 40,860. A 56 ms wheel source lag exceeded the 40 ms boundary requirement before final evaluation. This is the 9 November snapshot, preceding the README's later 50k failed-evaluation report."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_sysid", "label": "Descriptive command-to-wheel SysID", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L612-L647", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fits per-wheel gain, combined command-to-feedback delay and first-order time constant from final ROS command and reported speed. Requires at least three suitable whole sessions with a predeclared held-out session, reports identifiability boundaries and does not automatically retune geometry, PI or hardware."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_data_qc", "label": "Raw-session integrity and timing QC", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L649-L663", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Require normal bag closure, decoding/SQLite integrity, matching counts, hashes and provenance; explicitly report missing/nonfinite channels, reversed/duplicate clocks, gaps and interventions. Missing values remain missing. Observed rates do not prove packet loss, and Q2 integrity is not Q3/Q4 body, benefit or deployment validation."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_dataset_boundaries", "label": "Separate real SysID, Sim replay and real evaluation datasets", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L612-L629;L649-L659", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real inventory/SysID establishes sensor and response context; Sim transitions provide defined actions, rewards and terminations; real evaluation assesses fixed controllers. Teleop and observer bags are ineligible as ordinary TD3 replay by default."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_studio", "label": "Combined Nino Studio collection, training and evidence interface", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L665-L691", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides read-only recording with metadata/QC/export, Sim smoke/research training and checkpoint continuation, map/trajectory and episode/checkpoint monitoring, and historical evidence/to-do views. Historical evidence and live worker status are distinct."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_laya", "label": "Laya statistical interpretation advisory", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L674-L685", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports interpretation of statistics; does not train the actor, implement control, certify safety or choose a winner against evaluation evidence."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_reconnection_snapshot", "label": "9 November Pi sensor reconnection and observer-readiness snapshot", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L693-L718", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second 12-second probe observed sensors but receipt gaps up to about 345 ms. Five isolated Collision Monitor diagnostics passed and the monitor was subsequently closed. Studio discovery missed tf_static despite longer TF lookup success; the prepared QoS probe failed to execute after network loss. Remote liveness remained unverified and no new motion dataset started."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_unknown_step_task_plan", "label": "9 November unknown-step task implementation plan", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L720-L754;L778", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At this report date the work called for a physical traversal/arrival/path scorer, goal-stop, stall/timeout semantics, sensor-only adapter, hidden layouts, B0/B1 qualification and a bounded TD3 pilot. Tolerances and budgets were prospective. Later README entries establish subsequent implementation and evaluation progress."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_hardware_transfer_gates", "label": "TD3 Sim-to-real adapter and evidence requirements", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L34-L37;L124-L127;L599-L610;L722-L749", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real TD3 velocity authority requires matching observation/action ABI, mapping, export, firmware mode/owner qualification, measured backend dynamics and hardware tests. Separate SAC torque experiments and sensor bags do not validate this controller. Independent body-speed/slip reference and accepted velocity-backend SysID remain unresolved."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_sensor_topics", "label": "Physical sensor channels and derived ROS estimates", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L129-L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/imu/data and /motor_fb originate at STM32; the bridge republishes IMU and renamed wheel joints, computes encoder odometry, and an EKF may produce /odom. /scan_raw and deskewed /scan are not independent lasers. Raw left_wheel/right_wheel names differ from bridge left_wheel_joint/right_wheel_joint."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_clock_contract", "label": "Source, receipt, monotonic and simulation clock distinctions", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L180-L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Twist bag timestamp does not establish motor application time. Receipt-based response delay combines transport, shaping and actuator response. Raw IMU timestamps are preserved, while the legacy wheel/odometry sanitizer may repair invalid stamps; retain raw channels to distinguish these effects."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_geometry_mismatch", "label": "Simulation and Pi geometry declarations are not calibrated equivalence", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L74-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sim wheel radius/separation are 0.0625 m and 0.34273666 m versus Pi declarations 0.060 m and 0.345 m. Current Pi IMU TF is identity/zero, differing from historical yaw evidence. Declared TF, rolling radius, modeled mass/caster clearance and physical measurements are distinct."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_causal_export", "label": "Derived Parquet and causal 10 Hz export schema", "file_type": "concept", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L238-L240;L612-L629;L660-L663", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "causal_frames.parquet has its own feature/mask schema; it is not automatically the exact 100D/103D actor input or a TD3 transition. Export uses a separate repaired interpreter, and synthetic roundtrip tests establish software behavior rather than physical performance."}, {"id": "docs_nino_project_architecture_and_control_flow_2026_11_09_sensor_limits", "label": "Limits of encoder, gyro, accelerometer and horizontal LiDAR evidence", "file_type": "rationale", "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L148-L161;L642-L647", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wheel rotation is not independent body motion or longitudinal slip; gyro does not measure forward speed; acceleration includes gravity/mounting effects; horizontal LiDAR cannot preview every low obstacle. Endpoint ruler measurements establish displacement with uncertainty, without time-resolved onset, stopping or slip."}], "edges": [{"source": "docs_nino_project_architecture_and_control_flow_2026_11_09_overview", "target": "docs_nino_project_architecture_and_control_flow_2026_11_09_nino_robot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L11-L72", "weight": 1.0}, {"source": "docs_nino_project_architecture_and_control_flow_2026_11_09_overview", "target": "docs_nino_project_architecture_and_control_flow_2026_11_09_unknown_step_task_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/NINO_PROJECT_ARCHITECTURE_AND_CONTROL_FLOW_2026-11-09.md", "source_location": "L720-L754", "weight": 1.0}, {"source": "docs_nino_proj